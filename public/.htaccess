# Apache configuration for Thanjai Property CRM & Webhook API
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  AcceptPathInfo On

  # Enable Authorization Header
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Handle API requests
  RewriteRule ^api\.php(/.*)?$ api.php [QSA,L]
  RewriteRule ^api/(.*)$ api.php?resource= [QSA,L]

  # Direct access to physical files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route dashboard and admin requests
  RewriteRule ^dashboard\.html$ dashboard.html [L]
  RewriteRule ^login\.html$ login.html [L]
  RewriteRule ^user-dashboard\.html$ user-dashboard.html [L]

  # Fallback to index.html for SPA
  RewriteRule ^ index.html [L]
</IfModule>
