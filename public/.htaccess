# Apache configuration for Thanjai Property CRM & Webhook API
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  AcceptPathInfo On

  # Enable Authorization Header
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Handle API requests (including path info like /api.php/leads/L-123)
  RewriteRule ^api\.php(/.*)?$ api.php [QSA,L]
  RewriteRule ^api/(.*)$ api.php?resource=$1 [QSA,L]

  # Direct access to physical files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route dashboard and admin requests
  RewriteRule ^dashboard\.html$ dashboard.html [L]
  RewriteRule ^login\.html$ login.html [L]
  RewriteRule ^user-dashboard\.html$ user-dashboard.html [L]
  
  # Clean URL mappings matching vite.config.js
  RewriteRule ^admin-dashboard/?$ dashboard.html [L]
  RewriteRule ^user-dashboard/?$ user-dashboard.html [L]
  RewriteRule ^(admin-login|user-login|user-register|login|register)/?$ login.html [L]

  # Fallback to index.html for SPA
  RewriteCond %{REQUEST_URI} !^/api\.php
  RewriteRule ^ index.html [L]
</IfModule>
