<IfModule mod_rewrite.c>
  RewriteEngine On
  AcceptPathInfo On

  # Handle Clean URLs directly first
  RewriteRule ^admin-dashboard/?$ dashboard.html [L]
  RewriteRule ^user-login/?$ login.html [L]
  RewriteRule ^user-register/?$ login.html [L]
  RewriteRule ^login/?$ login.html [L]
  RewriteRule ^register/?$ login.html [L]
  RewriteRule ^user-dashboard/?$ user-dashboard.html [L]

  # If it's a real file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # CRITICAL: Don't rewrite api.php requests (including path info like /api.php/leads/L-123)
  RewriteCond %{REQUEST_URI} !^/api\.php
  RewriteRule ^(.*)$ index.html [L]
</IfModule>