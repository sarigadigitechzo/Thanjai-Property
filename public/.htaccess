<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Route /dashboard, /admin-dashboard, /admin, /crm to dashboard.html
  RewriteRule ^(dashboard|admin-dashboard|admin|crm)/?$ dashboard.html [L]

  # Route /login, /user-login, /user-register, /register to login.html
  RewriteRule ^(login|user-login|user-register|register)/?$ login.html [L]
  
  # Route /user-dashboard, /my-account to user-dashboard.html
  RewriteRule ^(user-dashboard|my-account)/?$ user-dashboard.html [L]
  
  # Fallback all other SPA routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
